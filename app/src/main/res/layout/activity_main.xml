<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nixi"
            android:textColor="@color/accent"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="18dp"
            android:text="Голосовой ассистент, который живёт поверх всех приложений"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Ключ OpenRouter"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="sk-or-v1-…"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword"
            android:textColor="@color/text"
            android:textColorHint="@color/hint"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="Модель для разговора"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTextModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="meta-llama/llama-3.3-70b-instruct:free"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="@color/text"
            android:textColorHint="@color/hint"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="Модель для экрана (со зрением)"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etVisionModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="google/gemini-2.0-flash-exp:free"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="@color/text"
            android:textColorHint="@color/hint"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Сохранить" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="6dp"
            android:text="1. Разрешение «поверх других приложений»"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Открыть настройки оверлея" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="2. Микрофон"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Разрешить микрофон" />

        <Button
            android:id="@+id/btnNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Разрешить уведомления" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/card"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:text="Проверяю разрешения…"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Запустить капсулу" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Остановить"
            android:textColor="@color/muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:lineSpacingExtra="4dp"
            android:text="Как пользоваться:\n1. Нажми капсулу сверху и скажи «привет».\n2. Скажи «что на экране» — Android спросит доступ к трансляции экрана, после этого ответ придёт голосом.\n3. Капсулу можно тащить пальцем вниз или вверх."
            android:textColor="@color/muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
